# Copy to .env (gitignored) and fill in. NEVER commit .env.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token. Treat as a password.
DISCORD_TOKEN=

# Your private test server's ID (enable Developer Mode in Discord, right-click server -> Copy Server ID).
# Used from Day 3 for instant guild-scoped command sync.
DEV_GUILD_ID=

# Your own user ID; used for owner-only commands from Day 4.
OWNER_ID=

# Optional
LOG_LEVEL=INFO
DATABASE_PATH=quartermaster.sqlite3
COMMAND_PREFIX=!
